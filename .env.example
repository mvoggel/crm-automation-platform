# .env.example - Copy to .env and fill in real values

# API Configuration
NODE_ENV=development
PORT=3000

# Authentication
API_SECRET=your-secret-here-change-this

# Default timezone
DEFAULT_TIMEZONE=America/New_York

# CRM Configs (these will move to client-specific files)
# LC_API_TOKEN=your-leadconnector-token
# LC_LOCATION_ID=your-location-id
# ST_API_TOKEN=your-servicetitan-token
# ST_TENANT_ID=your-tenant-id

# Google Sheets (for sales-report endpoint)
# Paste the full JSON content of your service account key file as a single line
# The service account must have Viewer access to each client's spreadsheet
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}